{
  "name": "partyline",
  "version": "0.1.0",
  "description": "PartyLine: story-driven AI party games on your friends' phones. Each case is an episode.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "call": "node src/call.js",
    "admin": "node scripts/admin.js",
    "vapid": "web-push generate-vapid-keys",
    "voice": "node scripts/intro-voice.js",
    "evidence": "node scripts/evidence-audio.js",
    "art": "node scripts/fetch-art.js",
    "say": "node scripts/say.js",
    "test": "node --test test/*.test.js",
    "usage": "node scripts/usage-report.js",
    "bench": "node bench/simulate.js",
    "eval:voice": "node scripts/eval-voice.js",
    "test:browser": "node --test test/browser/*.browser.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.0",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.0.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "twilio": "^5.3.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "gpt-tokenizer": "^4.0.0"
  }
}
