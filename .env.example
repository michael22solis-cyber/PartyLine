# Copy to .env and fill in.

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-...

# Voice model for every call. gpt-realtime (2025-08-28) is deprecated and shuts down 2027-01-20.
# Rollback: OPENAI_REALTIME_MODEL=gpt-realtime   (one character only: OPENAI_REALTIME_MODEL_RUTH=gpt-realtime)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# Caller transcription inside calls (for shared memory and clue detection). Family shuts down 2027-02-26.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Optional voice knobs (leave unset for the tested defaults):
# Noise and interruptions: the game (not OpenAI's turn detection) decides when a sound is a turn and when it may cut a
# character off, so a cough or a door doesn't interrupt or get answered.
# REALTIME_BARGE_IN_MS=500                  # keep talking this long over a character to interrupt it (higher = harder)
# REALTIME_BARGE_IN=on                      # off = characters can't be talked over; the caller is answered after
# REALTIME_MIN_TURN_MS=300                  # shorter sounds only count as a turn if their transcript has real words
# REALTIME_TURN_TAKING=managed              # server = the original behavior (any detected sound interrupts)
# REALTIME_NOISE_REDUCTION=                 # default far_field in the app (phone on speaker), near_field on real phone calls; off
# REALTIME_TURN_DETECTION=semantic_vad      # or server_vad
# REALTIME_VAD_THRESHOLD=0.6                # server_vad only, 0-1: higher = less sensitive to quiet sounds
# REALTIME_VAD_EAGERNESS=auto               # semantic_vad only: low | medium | high | auto
# REALTIME_MAX_OUTPUT_TOKENS=1500           # safety cap per spoken reply (~60 s); 'inf' to disable
# REALTIME_REASONING_EFFORT=                # 2.x models only: minimal | low | medium | high (unset = provider default)
# REALTIME_RETENTION_RATIO=                 # truncation; measured to cost MORE for 4-minute calls, so off by default
# REALTIME_TRANSPORT=ephemeral              # sideband = server holds a control socket on each in-app call
# CALL_IDLE_SECONDS=45                      # hang up after this long with nobody talking (0 = never)
# CALL_WRAP_UP=on                           # off = no "the line is fading" cue before the time limit
# MAX_CONCURRENT_CALLS=25                   # live calls across the whole server ("LINE BUSY" beyond this)
# MAX_CALLS_PER_PLAYER=30
# REVEAL_MODE=recording                     # live = the midnight reveal uses a live model even if the recording exists
# CALL_POOL_MINUTES=40                      # call minutes the whole group shares per game (calls characters place don't count); 0 = per player instead
# CALL_MINUTES_PER_PLAYER=20                # with CALL_POOL_MINUTES=0: minutes of calls each player can START per game (0 = unlimited)
# GAME_BUDGET_USD=5                         # hard AI budget per game: at the cap no more live calls; at 1.25x text replies stop too (0 = no cap)
# ELEVENLABS_MAX_CHARS_PER_DAY=2000         # hard daily cap on ElevenLabs speech the game sends (Caretaker lines, player names); 0 = none
# CALL_COOLDOWN_MINUTES=5                   # after a real call, that character won't pick up for this long (0 = off)

# Text replies
OPENAI_TEXT_MODEL=gpt-4.1-mini
# OPENAI_TEXT_FALLBACK_MODELS=gpt-4.1-mini,gpt-4o-mini
# OPENAI_TEXT_ESCALATION_MODEL=             # optional stronger model for accusations/evidence; off by default
# OPENAI_TEXT_CONCURRENCY=8                 # simultaneous text calls; waiting players are served round-robin
# OPENAI_TEXT_TIMEOUT_MS=20000
# OPENAI_TEXT_MAX_RETRIES=2
# TEXT_CONTEXT_TOKENS=800                   # budget per text reply prompt
# VOICE_MEMORY_TOKENS=350                   # memory budget inside a call's instructions
# TEXT_SKIP_ACKS=on                         # "ok"/"thanks" after a statement gets no reply (no model call); off to disable
# GROUP_CUT_IN_CHANCE=0.4

# Prompts: bounded (default: per-character knowledge, engine-approved secrets, compact memory) or legacy (rollback:
# the original prompts, where every character gets the full case file and judges its own locked clues).
# CONTEXT_MODE=bounded

# Usage ledger (data/usage.jsonl): `npm run usage` or `npm run admin -- usage`. USAGE_LEDGER=off disables it.
# GAME_ID=default

# ---------- Twilio ----------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# The number the Caretaker calls FROM (buy a local number in Twilio)
CARETAKER_NUMBER=+15555550100
# The number players call to reach Ruth (can be the same number for the demo)
RUTH_NUMBER=+15555550100

# Public HTTPS host of this server, no protocol (e.g. from ngrok: abcd-12-34.ngrok-free.app).
# Must match the webhook URL on your Twilio number (https://PUBLIC_HOST/voice): with TWILIO_AUTH_TOKEN set, /voice only
# answers requests carrying Twilio's signature for that URL.
PUBLIC_HOST=your-subdomain.ngrok-free.app
# TWILIO_WEBHOOK_VALIDATION=on              # off = skip the Twilio signature check on /voice
# Media streams carry a signed ticket from our TwiML; /media-stream refuses anything else (it opens a paid voice
# session). Set STREAM_SECRET when running more than one server; STREAM_AUTH=off disables the check.
# STREAM_SECRET=

PORT=5050

# Hard cap on any call, in seconds (the game rule is 4 minutes). Now enforced for incoming phone calls too.
MAX_CALL_SECONDS=240

# Optional: extra Twilio numbers so each suspect has their own line (otherwise calls go to Ruth)
MARCUS_NUMBER=
LILY_NUMBER=
TEDDY_NUMBER=

# Burner-phone app
ADMIN_KEY=pick-a-long-random-string
MAX_TEXTS_PER_PLAYER=150
# Timezone offset used when scheduling nights (-05:00 = Central Daylight Time)
GAME_TZ_OFFSET=-05:00

# Push notifications: run `npm run vapid` and paste the two keys here
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# The Caretaker's voice (optional): ElevenLabs key + the intro narrator's voice id. Used for the intro (`npm run voice`)
# and, when set on the server, for ALL his calls and the midnight reveal: his lines are generated once (cents),
# cached in DATA_DIR/voice and replayed, so he always sounds like the intro and his calls cost nothing per game.
# CARETAKER_VOICE=live keeps him on the live OpenAI voice instead.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_v4
# With the key set, the server also composes the background music once (5 one-minute tracks, creepier as the night goes
# on; ElevenLabs Music, or looping sound-effects ambience if your plan lacks it), cached in DATA_DIR/music. MUSIC=off disables.
